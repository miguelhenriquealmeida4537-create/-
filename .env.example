# Copie para .env.local e preencha. Nunca versione o arquivo real.
# Variáveis com prefixo VITE_ ficam visíveis no navegador: use apenas chaves públicas.

# URL pública do site (usada em canonical, Open Graph e sitemap)
VITE_SITE_URL=https://www.exemplo.com.br

# Supabase (Etapa futura) — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Conteúdo de TESTE (cardápio demonstrativo) enquanto o oficial não existe.
# Nunca ative em produção. Em desenvolvimento (npm run dev) já fica ativo.
VITE_SHOW_DEMO_CONTENT=false
